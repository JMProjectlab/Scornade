rules_version = '2';

// Chaque utilisateur ne voit et n'écrit que sous son propre identifiant.
// Hors de users/{uid} et du catalogue en lecture seule, aucun chemin n'est
// autorisé : tout le reste est donc refusé par défaut.
service cloud.firestore {
  match /databases/{database}/documents {

    // Le catalogue des jeux : les mêmes données pour tout le monde, en lecture
    // seule. C'est ce qui permet de corriger le libellé ou les règles d'un jeu,
    // et d'en ajouter un qui se compte avec un total par manche, sans publier
    // une nouvelle version de l'application.
    //
    // La lecture est ouverte, y compris sans compte. Ce n'est pas un
    // relâchement : le catalogue est déjà public — il est embarqué dans le
    // binaire de l'app et dans le JavaScript du site, que n'importe qui peut
    // lire. L'exiger authentifié ne protégeait rien, et privait de toute
    // correction les utilisateurs de « Continuer sans compte », qui sont
    // justement les plus nombreux.
    //
    // Aucun client ne peut y écrire — même authentifié. Les corrections passent
    // par la console Firebase, où c'est le compte propriétaire qui agit et non
    // une requête venue de l'app.
    match /games/{gameId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /players/{playerId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
